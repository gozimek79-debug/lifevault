# Przeglądarka widzi tylko zmienne VITE_. Klucze modeli NIE należą tutaj.

# Puste = tryb demo (IndexedDB, lokalna sesja, bez sieci).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Adres funkcji supabase/functions/extract-document. Puste = Tesseract w przeglądarce.
VITE_EXTRACT_FUNCTION_URL=

# Opcjonalny adres analizy czytnika (wizja, purpose=reader). Puste = ta sama funkcja extract-document.
# Bez obu adresów zostają Tesseract i heurystyki na urządzeniu. Klucz modelu zostaje po stronie serwera.
VITE_AI_EXTRACT_URL=

# Opcjonalne API, które zwraca JSON { "url": "https://..." }.
# Bez tego aplikacja zapisuje tylko gotowy link wyszukiwania i nie pobiera stron.
VITE_MANUAL_SEARCH_API_URL=

# Klucz publiczny Web Push (VAPID). Puste = zapisujemy tylko lokalną rezerwację, bez subskrypcji push.
VITE_VAPID_PUBLIC_KEY=

# Sekrety funkcji extract-document (ustawiane w Supabase, nigdy w Vite):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini
# ANTHROPIC_VISION_MODEL=claude-sonnet-4-5
# EXTRACT_PROVIDER=openai
# EXTRACT_REQUIRE_JWT=true
